css
 :root { color-scheme: light; font-family: Arial, Helvetica, sans-serif; color: #19332d; background: #f5f3ec; }
 * { box-sizing: border-box; }
 body { margin: 0; min-height: 100svh; display: grid; place-items: center; padding: 32px 24px; }
 main { width: 100%; max-width: 650px; padding: 48px 0; }
 .label { margin: 0 0 24px; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: #586b61; }
 h1 { margin: 0; font-size: clamp(64px, 16vw, 120px); line-height: 1; letter-spacing: -.065em; font-weight: 600; }
 .name { margin: 18px 0 0; font-size: 16px; color: #586b61; }
 .description { margin: 48px 0 32px; max-width: 560px; font-size: clamp(23px, 4vw, 30px); line-height: 1.45; letter-spacing: -.025em; }
 .contact { border-top: 1px solid #ccd3c6; padding-top: 24px; margin: 0; font-size: 15px; line-height: 1.8; color: #586b61; }
 a { color: #19332d; text-decoration-thickness: 1px; text-underline-offset: 4px; white-space: nowrap; }
 a:hover { text-decoration-thickness: 2px; }
 a:focus-visible { outline: 2px solid #19332d; outline-offset: 5px; border-radius: 2px; }
 @media (max-width: 480px) { main { padding: 24px 0; } .description { margin-top: 36px; } }

